rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/organisations/$(orgId)/members/$(uid);
    }

    function isOrgMember(orgId) {
      return signedIn()
        && exists(memberPath(orgId, request.auth.uid))
        && get(memberPath(orgId, request.auth.uid)).data.status == 'active';
    }

    function orgRole(orgId) {
      return get(memberPath(orgId, request.auth.uid)).data.role;
    }

    function isOrgOwner(orgId) {
      return isOrgMember(orgId) && orgRole(orgId) == 'owner';
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && orgRole(orgId) in ['owner', 'admin'];
    }

    function canCreateProject(orgId) {
      return isOrgMember(orgId) && orgRole(orgId) in ['owner', 'admin', 'member'];
    }

    function projectMemberPath(orgId, projectId, uid) {
      return /databases/$(database)/documents/organisations/$(orgId)/projects/$(projectId)/members/$(uid);
    }

    function isProjectMember(orgId, projectId) {
      return signedIn()
        && exists(projectMemberPath(orgId, projectId, request.auth.uid))
        && get(projectMemberPath(orgId, projectId, request.auth.uid)).data.status == 'active';
    }

    function projectRole(orgId, projectId) {
      return get(projectMemberPath(orgId, projectId, request.auth.uid)).data.role;
    }

    function canReadProject(orgId, projectId) {
      return isOrgAdmin(orgId) || isProjectMember(orgId, projectId);
    }

    function canManageProject(orgId, projectId) {
      return isOrgAdmin(orgId)
        || (isProjectMember(orgId, projectId) && projectRole(orgId, projectId) == 'project_manager');
    }

    function canContributeToProject(orgId, projectId) {
      return canManageProject(orgId, projectId)
        || (isProjectMember(orgId, projectId) && projectRole(orgId, projectId) == 'contributor');
    }

    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;

      match /organisations/{orgId} {
        // This is a user's navigation index only. Actual access is always checked
        // against organisations/{orgId}/members/{uid}.
        allow read, create, update, delete: if isSelf(uid);
      }

      match /personalTasks/{taskId} {
        allow read, create, update, delete: if isSelf(uid);
      }

      match /notifications/{notificationId} {
        allow read, delete: if isSelf(uid);
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
          && request.resource.data.read is bool;
        allow create: if false;
      }
    }

    match /organisations/{orgId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.status == 'active';

      allow read: if isOrgMember(orgId);
      allow update: if isOrgAdmin(orgId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOrgOwner(orgId);

      match /members/{memberUid} {
        allow read: if isOrgMember(orgId);

        // Initial owner membership must be created in the same atomic batch as
        // the organisation document, whose ownerUid is the signed-in user.
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/organisations/$(orgId)).data.ownerUid == request.auth.uid
          && request.resource.data.role == 'owner'
          && request.resource.data.status == 'active';

        allow update: if isOrgOwner(orgId)
          || (
            isOrgAdmin(orgId)
            && resource.data.role != 'owner'
            && request.resource.data.role in ['admin', 'member', 'guest']
          );
        allow delete: if isOrgAdmin(orgId)
          && memberUid != request.auth.uid
          && resource.data.role != 'owner';
      }

      match /teams/{teamId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgAdmin(orgId);
      }

      match /invitations/{invitationId} {
        allow read: if isOrgAdmin(orgId);
        allow create, update, delete: if isOrgAdmin(orgId);
      }

      match /projects/{projectId} {
        allow create: if canCreateProject(orgId)
          && request.resource.data.organisationId == orgId
          && request.resource.data.ownerUid == request.auth.uid;

        // Organisation members can see launch summary records; detailed project
        // resources remain restricted to project members and organisation admins.
        allow read: if isOrgMember(orgId) || isProjectMember(orgId, projectId);
        allow update: if canManageProject(orgId, projectId)
          && request.resource.data.organisationId == resource.data.organisationId
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if isOrgAdmin(orgId);

        match /members/{projectMemberUid} {
          allow read: if canReadProject(orgId, projectId);
          allow create: if (
              isOrgAdmin(orgId)
              && request.resource.data.uid == projectMemberUid
              && request.resource.data.role in ['project_manager', 'contributor', 'viewer']
            ) || (
              canManageProject(orgId, projectId)
              && request.resource.data.uid == projectMemberUid
              && request.resource.data.role in ['contributor', 'viewer']
            ) || (
              signedIn()
              && projectMemberUid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.role == 'project_manager'
              && getAfter(/databases/$(database)/documents/organisations/$(orgId)/projects/$(projectId)).data.ownerUid == request.auth.uid
            );
          allow update: if isOrgAdmin(orgId)
            || (
              canManageProject(orgId, projectId)
              && resource.data.role != 'project_manager'
              && request.resource.data.role in ['contributor', 'viewer']
            );
          allow delete: if isOrgAdmin(orgId)
            || (canManageProject(orgId, projectId) && resource.data.role != 'project_manager');
        }

        match /milestones/{milestoneId} {
          allow read: if canReadProject(orgId, projectId);
          allow create, update, delete: if canManageProject(orgId, projectId);
        }

        match /tasks/{taskId} {
          allow read: if canReadProject(orgId, projectId);
          allow create, update: if canContributeToProject(orgId, projectId);
          allow delete: if canManageProject(orgId, projectId);

          match /comments/{commentId} {
            allow read: if canReadProject(orgId, projectId);
            allow create: if canContributeToProject(orgId, projectId)
              && request.resource.data.authorUid == request.auth.uid;
            allow update, delete: if canManageProject(orgId, projectId)
              || (canContributeToProject(orgId, projectId) && resource.data.authorUid == request.auth.uid);
          }
        }

        match /activity/{activityId} {
          allow read: if canReadProject(orgId, projectId);
          // Activity is append-only and is written by trusted backend code.
          allow create, update, delete: if false;
        }

        match /files/{fileId} {
          allow read: if canReadProject(orgId, projectId);
          allow create, update: if canContributeToProject(orgId, projectId);
          allow delete: if canManageProject(orgId, projectId);
        }
      }
    }

    // All unspecified collections and documents are denied by default.
  }
}
